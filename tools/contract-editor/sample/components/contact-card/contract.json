      "width": 280,
      "height": "hug",
      "radius": "Radius/8",
      "background": "Color/Background/surface",
      "border": {
        "color": "Color/Border/default",
        "width": [
          "Stroke/1",
          "Stroke/1",
          "Stroke/1",
          "Stroke/1"
        ],
        "sides": {
          "top": 1,
          "end": 1,
