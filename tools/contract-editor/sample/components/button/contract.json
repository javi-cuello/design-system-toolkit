      "add": {
        "content/spinner": {
          "kind": "instance",
          "parent": "content",
          "component": "Icon container",
          "with": {
            "Icon": "loader-circle",
            "Size": "16"
          },
          "layout": {
            "direction": "row",
            "gap": "Spacing/0",
            "align": "start",
            "crossAlign": "center",
            "padding": {
              "top": "Spacing/0",
              "end": "Spacing/0",
              "bottom": "Spacing/0",
              "start": "Spacing/0"
            }
          },
          "width": "hug",
          "height": "hug",
          "order": 0
        },
        "content/spinner/glyph": {
          "kind": "instance",
          "parent": "content/spinner",
          "component": "loader-circle",
          "width": 16,
          "height": 16,
          "overflow": "hidden",
          "order": 0
        }
      }
    },
    {
      "when": {
        "disabled": true
