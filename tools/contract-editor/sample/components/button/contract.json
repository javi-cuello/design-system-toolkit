      },
      "set": {
        "content.layout": {
          "direction": "row",
          "gap": "Spacing/4",
          "align": "start",
          "crossAlign": "center",
          "padding": {
            "top": "Spacing/4",
            "end": "Spacing/12",
            "bottom": "Spacing/4",
            "start": "Spacing/12"
          }
        },
        "content.minHeight": 32,
        "content/label.typography": "Label/sm"
      }
    },
    {
      "when": {
        "role": "secondary"
      },
      "set": {
        "root.background": "Color/Background/surface",
        "root.border": {
          "color": "Color/Border/default",
          "width": [
            "Stroke/1",
            "Stroke/1",
            "Stroke/1",
            "Stroke/1"
          ],
          "sides": {
            "top": 1,
            "end": 1,
            "bottom": 1,
            "start": 1
          }
        },
        "content/label.color": "Color/Text/primary"
      }
    },
    {
      "when": {
        "state": "hover"
