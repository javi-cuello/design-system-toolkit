            "vertical": "stretch"
          },
          "radius": "Radius/8",
          "border": {
            "color": "Color/Border/focus",
            "width": [
              "Stroke/1",
              "Stroke/1",
              "Stroke/1",
              "Stroke/1"
            ],
            "sides": {
              "top": 1,
              "end": 1,
              "bottom": 1,
              "start": 1
            }
          },
          "shape": "rectangle",
          "order": 2
        }
      }
    },
    {
      "when": {
