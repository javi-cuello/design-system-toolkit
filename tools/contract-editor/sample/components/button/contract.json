      "set": {
        "root.opacity": "Effect/Disabled/opacity"
      }
    },
    {
      "when": {
        "showIcon": true
      },
      "add": {
        "content/icon": {
          "kind": "instance",
          "parent": "content",
          "component": "Icon container",
          "with": {
            "Icon": "star",
            "Size": "16"
          },
          "layout": {
            "direction": "row",
            "gap": "Spacing/0",
            "align": "start",
            "crossAlign": "center",
            "padding": {
              "top": "Spacing/0",
              "end": "Spacing/0",
              "bottom": "Spacing/0",
              "start": "Spacing/0"
            }
          },
          "width": "hug",
          "height": "hug",
          "order": 0
        },
        "content/icon/glyph": {
          "kind": "instance",
          "parent": "content/icon",
          "component": "star",
          "width": 16,
          "height": 16,
          "overflow": "hidden",
          "order": 0
        }
      }
    },
    {
      "when": {
        "role": "secondary",
        "state": "hover"
      },
      "set": {
        "root.background": "Color/Background/hover"
      }
    },
    {
      "when": {
        "showIcon": true,
        "state": "loading"
      },
      "remove": [
        "content/icon",
        "content/icon/glyph"
      ]
    }
