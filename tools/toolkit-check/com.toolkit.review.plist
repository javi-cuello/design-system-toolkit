<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The periodic review (bin/review, toolkit-standard §D 11), the maintainer's only: install.sh writes it to
     ~/Library/LaunchAgents only when run as REVIEW=on ./install.sh, with TOOLKIT, NODE_DIR, LOGS and USERHOME
     replaced. Daily at 03:00 (a Mac asleep then runs it on waking); bin/review acts only when a review is owed.
     launchd starts with a bare PATH: bin/check calls node, python3 and pnpm, and the run calls claude, which
     lives in ~/.local/bin. -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>NODE_DIR:USERHOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.toolkit.review</string>
	<key>ProgramArguments</key>
	<array>
		<string>TOOLKIT/bin/review</string>
		<string>--if-owed</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>LOGS/review.err</string>
	<key>StandardOutPath</key>
	<string>LOGS/review.log</string>
</dict>
</plist>
