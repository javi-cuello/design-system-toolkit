---
/*
 * Effect styles — shadows and blurs. One row per style.
 *
 * The name with its code beneath, then the value; the Preview view draws the
 * shadows. The value carries the offset, blur and
 * spread in the order CSS states them (`0px 4px 8px -2px rgb(…)`), and it is
 * the string a builder copies, as Duet documents its box shadows. Paint
 * styles have their own page.
 */
import Base from '../../layouts/Base.astro';
import UpdatedBy from '../../components/UpdatedBy.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import { snapshot } from '../../lib/snapshot.js';
import { shadowsOf, cssName } from '../../lib/project.js';
import { plural } from '../../lib/format.js';

const effects = snapshot.effects || [];
const shadows = shadowsOf(snapshot);
const TYPE = { DROP_SHADOW: 'Drop shadow', INNER_SHADOW: 'Inner shadow', LAYER_BLUR: 'Layer blur', BACKGROUND_BLUR: 'Background blur' };

// The effect styles' own DTCG collection, which is what the token build names
// their custom property from.
const code = (name) => cssName('effect-style', name);
/*
 * A blur has no `box-shadow`, so it has no value string and would otherwise
 * print an empty cell in the one column that is meant to be copyable. Its
 * layers say it instead: "Layer blur 8px".
 */
const layersText = (e) => e.layers.map((l) => [TYPE[l.type] || l.type, l.blur != null ? `${l.blur}px` : null].filter(Boolean).join(' ')).join(', ');
// A shadow's layers, one a line: split at the commas between layers, never
// inside a colour's brackets, so a value wraps between layers, not in one.
const layersOf = (v) => {
  const out = [''];
  let depth = 0;
  for (const ch of v) {
    if (ch === ',' && depth === 0) { out.push(''); continue; }
    if (ch === '(') depth++;
    if (ch === ')') depth--;
    out[out.length - 1] += ch;
  }
  return out.map((l) => l.trim());
};
const kinds = (e) => [...new Set(e.layers.map((l) => TYPE[l.type] || l.type))].join(', ');
---
<Base title="Effect styles">
  <h1>Effect styles</h1>
  <UpdatedBy from={['snapshot']} />
  <p class="lede">{plural(effects.length, 'shadow and blur style')}. Click a code name or value to copy it.</p>

  {effects.length === 0 && <p class="note">This library defines none.</p>}

  {effects.length > 0 && (
  <div class="toolbar">
    <div class="toolbar__filters">
      <ViewToggle key="effect" label="Show shadows as"
        options={[{ value: 'table', label: 'Table' }, { value: 'preview', label: 'Preview' }]} />
    </div>
  </div>
  )}

  {effects.length > 0 && (
  <div data-views="effect">
    {/* Name, its kinds and its code in one cell, the value beside it: the
        value is the long part (four shadow layers), so it gets the width,
        and a name breaks after each slash rather than running under the
        next column. On a phone each style is a block. */}
    <div class="table-wrap" data-scrolls data-view="table">
      <table class="table table--stack">
        <caption class="visually-hidden">Effect styles and their values</caption>
        <thead><tr><th scope="col">Name and code</th><th scope="col">Value</th></tr></thead>
        <tbody>
          {effects.map((e) => (
            <tr>
              <th scope="row">
                <span class="token-name">{e.name.split('/').map((seg, k) => <>{k > 0 && <>/<wbr /></>}{seg}</>)}</span>
                <span class="token-desc">{kinds(e)}</span>
                <button type="button" class="code-chip" data-copy={`var(${code(e.name)})`} aria-label={`Copy ${code(e.name)}`}>{code(e.name)}</button>
              </th>
              <td class="table__cell--wide" data-label="Value">
                {/* The value only: the Preview view draws each shadow at the
                    size it is used, and a 3rem chip here only showed that one existed. */}
                {shadows.get(e.name)
                  ? <button type="button" class="value__raw" data-copy={shadows.get(e.name)} aria-label="Copy the shadow value">{layersOf(shadows.get(e.name)).map((l, k, all) => <span class="value__layer">{l}{k < all.length - 1 && ','}</span>)}</button>
                  : <span class="muted">{layersText(e)}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* The shadow at the size it is used: a card, not a chip. A 2.5rem swatch
        shows that a shadow exists; it does not show the difference between
        Raised and Floating, which is the question this page is asked. */}
    <ol class="shadow-grid" data-view="preview">
      {effects.map((e) => (
        <li class="shadow-card" style={`--effect: ${shadows.get(e.name) || 'none'}`}>
          <p class="shadow-card__label">
            <span class="token-name">{e.name}</span>
            <button type="button" class="code-chip" data-copy={`var(${code(e.name)})`} aria-label={`Copy ${code(e.name)}`}>{code(e.name)}</button>
          </p>
        </li>
      ))}
    </ol>
  </div>
  )}
</Base>
