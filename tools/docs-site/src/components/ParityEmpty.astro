---
// What a Parity page says before it has anything to compare: one message
// for all five pages, so Coverage and the code-audit pages never disagree
// about what is missing (feedback.md *Empty states*). It names what the
// page will show and what fills it; the command to run appears only once
// the project names its code, with the project filled in, never a
// placeholder for the reader to complete.
import { codeOf, project } from '../lib/project.js';
import EmptyState from './EmptyState.astro';

interface Props { shows: string; needs?: 'code' | 'audit' | 'tokens' }
const { shows, needs = 'audit' } = Astro.props;
const named = codeOf.size > 0;
---
{!named ? (
  <EmptyState title="The comparison with code lands here" level={2}>This project names no code yet. Once its audit settings name the repository and the folder that holds its components, this page shows {shows}.</EmptyState>
) : needs === 'code' ? null : (
  <EmptyState title="The comparison with code lands here" level={2}>No code audit has run yet; once it has, this page shows {shows}. {needs === 'tokens' ? <>Name the code's token files under <code>code.parity.tokens</code> in the context document, then run </> : <>Map the code's stories in the parity mappings (where <code>code.parity.mappings</code> says), then run </>}<code>node tools/parity/external.mjs --project {project.id}</code>.</EmptyState>
)}
