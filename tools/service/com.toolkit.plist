<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The toolkit's one login item: supervisor.mjs, which runs the snapshot router and the figma-audit service
     (and, where installed, the daily periodic review). install.sh writes it to ~/Library/LaunchAgents with the
     checkout, node's folder, the logs folder (~/Library/Logs/toolkit) and the home folder filled in, and the
     review line kept only when the review is on. launchd starts with a bare PATH: a project's after-snapshot steps
     call node, sass and pnpm, bin/check calls python3, and the review calls claude, in ~/.local/bin. `toolkit` is
     a link to node, so Login Items names the item rather than "node". -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>NODE_DIR:USERHOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.toolkit</string>
	<key>ProgramArguments</key>
	<array>
		<string>TOOLKIT/tools/service/toolkit</string>
		<string>TOOLKIT/tools/service/supervisor.mjs</string>
		<string>REVIEWARG</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>LOGS/toolkit.err</string>
	<key>StandardOutPath</key>
	<string>LOGS/toolkit.log</string>
</dict>
</plist>
