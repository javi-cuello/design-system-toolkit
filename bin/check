}

# The dashboard is one long script in one scope; its check lives with the page, in the docs engine.
# A fresh clone has no packages: a skip here (a failure in CI, which installs them), never a red that hides new reds.
s_docs_engine() {
step "the docs engine resolves"
if [ ! -d tools/docs-site/node_modules ]; then skip "the docs site's packages are not installed: run (cd tools/docs-site && pnpm install --frozen-lockfile)"
elif OUT=$(node tools/docs-site/src/dashboard/check.mjs 2>&1); then ok; else bad "$OUT"; fi
}

# The docs site is the toolkit's own front end, and nothing held it to
