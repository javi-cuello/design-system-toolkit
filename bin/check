TAB=$(printf '\t')
# The steps in order, one line each: shares, function, arguments (tab-separated).
steps_list() {
    l() { printf '%s' "$1"; shift; printf '\t%s' "$@"; printf '\n'; }
    l -        s_wellformed
    # healing writes into the tree every other step reads
    l "$([ -n "$FIX" ] && echo alone || echo -)" s_standards
    l -        s_project_data
    l -        s_uncommitted
    # the sweep prunes and removes worktrees and deletes branches of this repo, which the steps cloning it read
    l alone    s_leftovers
    l -        s_owned
    l -        s_project_paths
    l -        s_machine_home
    l -        s_readability
    l -        s_readmes
    l -        s_push_hook
    l -        s_restated
    l -        s_main_guards
    l -        s_no_project_named
    l -        s_research_index
    l -        s_twins
    l -        s_services
    l -        s_docs_engine
    l -        s_docs_sheets
    l -        s_audit_rows
    [ "$QUICK" = "1" ] && return 0
    HOMES=$(node tools/snapshot/projects.cjs homes) || l - s_project_list
    while IFS="$TAB" read -r label home; do
        [ -f "$home/site/index.html" ] || continue
        l chrome s_structure "$label" "$home"
        l -      s_mcp "$label" "$home"
    done <<EOF
$HOMES
EOF
    while IFS="$TAB" read -r label home; do
        [ -d "$home/snapshot/components" ] && l - s_specs "$label" "$home"
    done <<EOF
$HOMES
EOF
    l chrome,home:downloads s_editor_sample
    l -      s_skills_install
    l -      s_every_skill
    while IFS="$TAB" read -r label home; do
        # no project: the list is empty, and the here-document still gives one empty line
        [ -n "$label" ] && l chrome,home:downloads s_editor "$label"
    done <<EOF
$HOMES
EOF
    suites | SUITE_SHARES="$SUITE_SHARES" awk 'BEGIN { n = split(ENVIRON["SUITE_SHARES"], r, "\n"); for (i = 1; i <= n; i++) if (split(r[i], f, " ") >= 2) s[f[1]] = f[2] }
        { print (($0 in s) ? s[$0] : "alone") "\ts_suite\t" $0 }'
}

case "$INNER" in
--list) steps_list; exit 0 ;;
--step)
    # one step, alone: its failed and skipped names go where the scheduler reads them
    case "${1:-}" in s_*) ;; *) echo "bin/check --step: no step $1" >&2; exit 2 ;; esac
    fn=$1; shift
    "$fn" "$@"
    printf '%s' "$FAILED" > "$TOOLKIT_CHECK_STATE.failed"; printf '%s' "$SKIPPED" > "$TOOLKIT_CHECK_STATE.skipped"
    exit $FAIL ;;
esac

if [ "$WORKERS" = "1" ]; then
    # read on fd 3, so a step keeps the run's stdin
    while IFS="$TAB" read -r shares fn a1 a2 <&3; do "$fn" "$a1" "$a2"; done 3<<EOF
$(steps_list)
EOF
else
    # each step alone in its own bin/check, its output kept and printed whole in list order: the run reads as a
    # serial one, the closing summary included
    ST=$(mktemp -d)
    steps_list | TOOLKIT_CHECK_FIX="$FIX" node tools/toolkit-check/check-parallel.mjs --workers "$WORKERS" --limit "$LIMITS" --state "$ST" -- sh "$REPO/bin/check" --step
    gather "$ST" $?
    rm -rf "$ST"
fi

[ "$FAIL" = "0" ] && { [ "$QUICK" = "1" ] && green " (quick)" || green; } || summary
exit $FAIL
